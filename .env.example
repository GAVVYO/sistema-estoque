# Apenas desenvolvimento local. Copie para .env e altere as senhas antes de uso compartilhado.
DATABASE_URL=mysql://stock_dev:stock_dev@127.0.0.1:3306/stock_v2
API_PORT=3000
# Origem exata do frontend, sem barra final (CORS + proteção CSRF).
WEB_ORIGIN=http://localhost:5173
# Gere um segredo aleatório de ao menos 32 caracteres; obrigatório, sem fallback.
JWT_SECRET=
# URL pública da API, incluindo o prefixo /api. Vite lê o .env da raiz.
VITE_API_URL=http://localhost:3000/api
NODE_ENV=development

# Upload de imagens. Preencha somente no ambiente da API; nunca use VITE_ nestas chaves.
# Sem configuração, URLs existentes continuam funcionando e o upload informa indisponibilidade.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Infraestrutura local do Docker Compose
MYSQL_USER=stock_dev
MYSQL_PASSWORD=stock_dev
MYSQL_DATABASE=stock_v2

# Seed local. Use uma senha diferente fora do seu computador.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Backups SQL consistentes. Pasta privada absoluta em produção, fora de public_html.
BACKUP_DIRECTORY=../../var/backups
BACKUP_AUTO_ENABLED=true
BACKUP_HOUR=02:00
BACKUP_TIME_ZONE=America/Fortaleza
BACKUP_RETENTION_DAYS=365
BACKUP_TIMEOUT_SECONDS=90
# Na Hostinger, use external + inline e cron para pnpm backup:tick.
BACKUP_SCHEDULER_MODE=internal
BACKUP_EXECUTION_MODE=background
# Opcional, conexão de leitura dedicada. Caso ausente, usa DATABASE_URL.
# BACKUP_DATABASE_URL=mysql://...
# Servir o frontend compilado no mesmo processo NestJS na Hostinger.
SERVE_WEB=false
